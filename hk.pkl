amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// Report every failing step in one run instead of stopping at the first one:
// the linters below carry pre-existing findings and one failure should not hide
// the rest.
fail_fast = false

// droast ships as `dockerfile-roast` in the pinned mise tool, so the builtin's
// `droast` command needs the name the project actually installs.
local droast = (Builtins.droast) {
    check = "dockerfile-roast {{files}}"
    fix = "dockerfile-roast --fix {{files}}"
}

// check: the full read-only set. Run it deliberately (`hk check --all`); it
// still reports a pre-existing backlog, and some of these tools are optional
// locally, so skip the ones you do not have with `HK_SKIP_STEPS=dclint,droast`.
local checks = new Mapping<String, Step> {
    ["go_vet"] = Builtins.go_vet
    ["golangci_lint"] = Builtins.golangci_lint
    ["actionlint"] = Builtins.actionlint
    ["zizmor"] = Builtins.zizmor
    ["dclint"] = Builtins.dclint
    ["hadolint"] = Builtins.hadolint
    ["droast"] = droast
    ["shellcheck"] = Builtins.shellcheck
}

hooks {
    ["check"] {
        steps = checks
    }
    // Committing stays green: go_vet compiles every package, while golangci_lint
    // still has a backlog and the mutating linters would reformat the 20+ files
    // that were never gofmt'd.
    ["pre-commit"] {
        steps {
            ["go_vet"] = Builtins.go_vet
        }
    }
    // fix: mutations. go_fmt will also reformat files that were never gofmt'd,
    // so expect a large first run.
    ["fix"] {
        fix = true
        steps {
            ["go_fmt"] = Builtins.go_fmt
            ["shellharden"] = Builtins.shellharden
            ["gomod_tidy"] = Builtins.gomod_tidy
        }
    }
}
